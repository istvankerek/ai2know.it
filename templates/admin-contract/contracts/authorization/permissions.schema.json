{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibos.space/contracts/authorization/permissions.schema.json",
  "title": "Partner projekt jogosultság-katalógus",
  "description": "Egy partner projekt admin API jogosultság-katalógusa és szerepkör-definíciói. Deny-by-default: ami nincs a katalógusban, az tiltott. Nincs wildcard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "realm",
    "prefix",
    "separator",
    "implicit_default",
    "wildcards_allowed",
    "missing_permission_behavior",
    "groups",
    "roles"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "realm": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "A projekt realm neve (pl. aibootcamp). Ez lesz a permission kódok első szegmense."
    },
    "source": { "type": "string" },
    "normative_role_matrix": { "type": "string" },
    "prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.$",
      "description": "A permission kódok előtagja, ponttal zárva (pl. aibootcamp.)"
    },
    "separator": {
      "type": "string",
      "const": ".",
      "description": "Elválasztó karakter — csak pont megengedett"
    },
    "implicit_default": {
      "type": "string",
      "const": "DENY",
      "description": "Alapértelmezett viselkedés ismeretlen permission esetén — mindig DENY"
    },
    "wildcards_allowed": {
      "type": "boolean",
      "const": false,
      "description": "Wildcard (*) tiltott minden szinten"
    },
    "missing_permission_behavior": {
      "type": "string",
      "const": "DENY"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "permissions"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "description"],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                  "description": "Formátum: {realm}.{modul}.{akció} — ponttal elválasztva, wildcard nélkül"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "grant_rule"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "grant_rule": {
            "type": "string",
            "enum": ["ALL", "ALL_EXCEPT", "EXPLICIT"],
            "description": "ALL: minden permission megadva; ALL_EXCEPT: minden kivéve listed; EXPLICIT: csak a role-matrix-ban felsorolt"
          },
          "excluded": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Csak ALL_EXCEPT esetén értelmezett — kizárt permission kódok"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
