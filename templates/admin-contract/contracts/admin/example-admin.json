{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Bootcamp Admin API",
    "version": "1.0.0",
    "description": "Az aibos.space konzol által hívott admin REST API (contract-first sablon). Hitelesítés: workloadJwt Bearer + X-Actor-Assertion JWS. Lapozás: cursor-alapú. Hibák: RFC 7807 application/problem+json."
  },
  "servers": [
    { "url": "http://localhost:8081", "description": "Helyi fejlesztés" }
  ],
  "security": [{ "workloadJwt": [], "actorAssertion": [] }],
  "tags": [{ "name": "health" }, { "name": "courses" }, { "name": "students" }],
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["health"],
        "operationId": "healthLive",
        "summary": "Él-e a folyamat",
        "security": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": { "schema": { "type": "string", "const": "ok" } }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["health"],
        "operationId": "healthReady",
        "summary": "Elérhető-e az adatbázis",
        "security": [],
        "responses": {
          "200": { "description": "kész" },
          "503": {
            "description": "az adatbázis nem érhető el",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" }
              }
            }
          }
        }
      }
    },
    "/api/admin/v1/courses": {
      "get": {
        "tags": ["courses"],
        "operationId": "listCourses",
        "summary": "Kurzusok listája",
        "x-permission": "courses.list",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Search" },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/CourseStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "Kurzus lista lap",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CourseList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      },
      "post": {
        "tags": ["courses"],
        "operationId": "createCourse",
        "summary": "Kurzus létrehozása",
        "x-permission": "courses.create",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CourseInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Létrehozva",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Course" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/admin/v1/courses/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/CourseId" }],
      "get": {
        "tags": ["courses"],
        "operationId": "getCourse",
        "summary": "Kurzus részletei",
        "x-permission": "courses.view",
        "responses": {
          "200": {
            "description": "Kurzus",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Course" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["courses"],
        "operationId": "updateCourse",
        "summary": "Kurzus részleges módosítása",
        "x-permission": "courses.edit",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CoursePatch" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Módosítva",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Course" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "412": { "$ref": "#/components/responses/PreconditionFailed" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      },
      "delete": {
        "tags": ["courses"],
        "operationId": "deleteCourse",
        "summary": "Kurzus soft törlése",
        "x-permission": "courses.delete",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "204": { "description": "Törölve" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/admin/v1/courses/{id}/publish": {
      "parameters": [{ "$ref": "#/components/parameters/CourseId" }],
      "post": {
        "tags": ["courses"],
        "operationId": "publishCourse",
        "summary": "Kurzus publikálása",
        "x-permission": "courses.publish",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": {
            "description": "Publikálva",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Course" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/admin/v1/courses/{id}/history": {
      "parameters": [{ "$ref": "#/components/parameters/CourseId" }],
      "get": {
        "tags": ["courses"],
        "operationId": "getCourseHistory",
        "summary": "Kurzus auditnapló",
        "x-permission": "courses.history",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Auditnapló lap",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditEntryList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/v1/students": {
      "get": {
        "tags": ["students"],
        "operationId": "listStudents",
        "summary": "Diákok listája",
        "x-permission": "students.list",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Search" }
        ],
        "responses": {
          "200": {
            "description": "Diák lista lap",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StudentList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/admin/v1/students/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "get": {
        "tags": ["students"],
        "operationId": "getStudent",
        "summary": "Diák részletei",
        "x-permission": "students.view",
        "responses": {
          "200": {
            "description": "Diák",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Student" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "workloadJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "aibos M2M workload token. Kiadó: https://aibos.space."
      },
      "actorAssertion": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Actor-Assertion",
        "description": "JWS kompakt token (typ=aibos-actor+jwt, EdDSA/Ed25519). Max 120 s élettartam."
      }
    },
    "parameters": {
      "CourseId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": { "type": "string" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "schema": { "type": "string", "maxLength": 200 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "schema": { "type": "string", "format": "uuid" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "schema": { "type": "string" }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "correlation_id": { "type": "string", "format": "uuid" }
        }
      },
      "CourseStatus": {
        "type": "string",
        "enum": ["draft", "published", "archived"]
      },
      "Course": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "status": { "$ref": "#/components/schemas/CourseStatus" },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "version": { "type": "string" }
        }
      },
      "CourseList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Course" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "CourseInput": {
        "type": "object",
        "required": ["slug", "title"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "CoursePatch": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "AuditEntry": {
        "type": "object",
        "required": [
          "id",
          "ts",
          "operatorId",
          "permission",
          "httpMethod",
          "path",
          "entityType",
          "entityId",
          "outcome"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "ts": { "type": "string", "format": "date-time" },
          "operatorId": { "type": "string" },
          "permission": { "type": "string" },
          "httpMethod": { "type": "string" },
          "path": { "type": "string" },
          "entityType": { "type": "string" },
          "entityId": { "type": "string" },
          "reason": { "type": "string", "nullable": true },
          "ticket": { "type": "string", "nullable": true },
          "outcome": {
            "type": "string",
            "enum": ["success", "denied", "error"]
          }
        }
      },
      "AuditEntryList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuditEntry" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "Student": {
        "type": "object",
        "required": ["id", "skillpassSub", "enrolledAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "skillpassSub": { "type": "string" },
          "enrolledAt": { "type": "string", "format": "date-time" },
          "completedCourseCount": { "type": "integer", "minimum": 0 }
        }
      },
      "StudentList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Student" }
          },
          "nextCursor": { "type": "string" }
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Hiányzó vagy érvénytelen hitelesítés",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Forbidden": {
        "description": "Nincs jogosultság",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "NotFound": {
        "description": "Nem található",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "Conflict": {
        "description": "Ütközés",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "PreconditionFailed": {
        "description": "Elavult If-Match érték",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Validációs hiba",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    }
  }
}
