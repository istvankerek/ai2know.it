# ================================
# Kornyezeti valtozok sablon
# Masold: cp .env.example .env.local
# ================================

# --- Alkalmazas ---
APP_NAME=your-project-name
APP_ENV=local
APP_PORT=3000
APP_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_db_name
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/your_db

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- MinIO (S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=your-bucket

# --- Hetzner S3 (Backup) ---
HETZNER_S3_ENDPOINT=your_endpoint
HETZNER_S3_ACCESS_KEY=your_key
HETZNER_S3_SECRET_KEY=your_secret
HETZNER_S3_BUCKET=your-backup-bucket

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- SkillPass.ID Auth (egyetlen IdP, BFF confidential client) ---
SKILLPASS_ISSUER=https://skillpass.id
SKILLPASS_CLIENT_ID=your_client_id
SKILLPASS_CLIENT_SECRET=your_client_secret
SKILLPASS_REDIRECT_URI=http://localhost:8080/auth/callback
SKILLPASS_COOKIE_SECRET=generate_with_openssl_rand_hex_32
# M2M (client_credentials, legszukebb scope)
SKILLPASS_M2M_CLIENT_ID=your_m2m_client_id
SKILLPASS_M2M_CLIENT_SECRET=your_m2m_client_secret

# --- AIOS orchestrator (helyi modellek, csak localhost) ---
AIOS_LOCAL_MLX_URL=http://127.0.0.1:8080/v1
AIOS_LOCAL_LMSTUDIO_URL=http://127.0.0.1:1234/v1
AIOS_LOCAL_LLAMACPP_URL=http://127.0.0.1:8081/v1

# --- Mailgun ---
MAILGUN_API_KEY=your_api_key
MAILGUN_DOMAIN=your_domain
MAILGUN_EU=true

# --- Cloudflare ---
CLOUDFLARE_TUNNEL_TOKEN=your_token

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=your_password

# --- Ertesitesek ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SLACK_WEBHOOK_URL=your_webhook_url

# --- AI ---
ANTHROPIC_API_KEY=your_api_key

# --- Vite Frontend (VITE_ prefix kotelezo kliens oldalon!) ---
VITE_APP_NAME=your-project-name
VITE_API_URL=http://localhost:8080/api/v1
# Auth: a frontend NEM kap client ID-t/tokent – a backend BFF kezeli (/auth/*)
