  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-safety.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-injection.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-router.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-bash-safety.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/rtk-filter.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-bash-cap.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-read-warn.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/memory/memory-context-load.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/intelligent-router.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/memory/memory-relevance-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/memory/memory-observation-capture.sh"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-lint.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-placeholders.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-brand.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-tdd.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-commit.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-tool-cost.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/agent-teams/teammate-idle.sh"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/agent-teams/task-created.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/agent-teams/task-completed.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/memory/memory-session-summary.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/save-prompt-log.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/memory/memory-promote-patterns.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/session-end-report.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/save-agent-memory.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-backup.sh"
          }
        ]
      }
    ]
  }
}
